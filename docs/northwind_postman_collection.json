            "body": {
              "mode": "raw",
              "raw": "{\n  \"c_ProductName\": \"ชาเขียวมัทฉะแท้\",\n  \"i_CategoryID\": 1,\n  \"i_SupplierID\": 1,\n  \"c_Unit\": \"20 ซอง\",\n  \"i_Price\": 150.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products/1",
              "host": ["{{baseUrl}}"],
